{
  "expo": {
    "name": "Rural Digital Doctor",
    "slug": "dejiadenusi",
    "version": "0.1.0",
    "scheme": "ruraldigitaldoctor",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rural Digital Doctor uses the camera so you can photograph test results and scans for your doctor.",
          "photosPermission": "Rural Digital Doctor opens your photos so you can share test results and scans with your doctor."
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Rural Digital Doctor uses Face ID to keep your health records private."
        }
      ]
    ],
    "android": {
      "package": "com.ruraldigitaldoctor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#3A0FA8"
      },
      "allowBackup": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ruraldigitaldoctor.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Landu uses the microphone for your doctor visits.",
        "NSCameraUsageDescription": "Landu uses the camera for video visits and to photograph test results.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "owner": "unlimitedejis-team",
    "extra": {
      "eas": {
        "projectId": "961719ed-5a31-4b26-88ec-d261d097bb7d"
      }
    },
    "icon": "./assets/icon.png"
  }
}
